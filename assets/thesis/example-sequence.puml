@startuml
actor Kunde as k
participant System as s

k -> s : Anfrage senden
s --> k : Empfangsbestätigung
k -> s : Anmeldedaten eingeben
s -> s : Authentifizierung prüfen

alt Authentifizierung erfolgreich
    s --> k : Zugriff gewährt
else Authentifizierung fehlgeschlagen
    s --> k : Zugriff verweigert
end
@enduml
