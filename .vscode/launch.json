{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Run lsp-gpt extension",
        "type": "extensionHost",
        "request": "launch",
        "runtimeExecutable": "${execPath}",
        "args": [
          "--extensionDevelopmentPath=${workspaceFolder}/clients/vscode",
          // "--disable-extensions",
          "${workspaceRoot}/assets/example.plantuml"
        ]
      }
    ]
  }